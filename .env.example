# 复制成 .env 再填，或者用 `python scripts/setup_env.py` 一次性写到用户级目录
# （~/.signal-desk/.env —— 换新版本的包也不用重配）。
#
# **.env 不进版本库、不进分发包。** 离线验收不需要任何凭据。

# 期货行情（自有 Quote API）
QUOTE_API_BASE=https://your-quote-host:port
QUOTE_API_KEY=
# 自签名证书指纹固定。**不要用 verify=False** —— 请求头带着 AK，等于放弃 MITM 防护。
# 用 scripts/pin_tls.py 生成。
QUOTE_API_TLS_FINGERPRINT=

# 推送（都留空则只打控制台）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BARK_URL=

# 加密行情走 OKX 公开接口，无需凭据（ADR-0005）
# 实盘交易（M5）尚未开启，CTP/BINANCE 相关配置届时再加
